{
  "name": "@nuxtjs/shopify",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Easily integrate Shopify with Nuxt 🚀",
  "packageManager": "pnpm@11.28.11",
  "workspaces": [
    "playgrounds/*",
    "template",
    "docs",
    "."
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/shopify.git"
  },
  "homepage": "https://shopify.nuxtjs.org",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./storefront": {
      "types": "./dist/clients/storefront.d.ts"
    },
    "./customer-account": {
      "types": "./dist/clients/customer-account.d.ts"
    },
    "./admin": {
      "types": "./dist/clients/admin.d.ts"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "storefront": [
        "./dist/clients/storefront.d.ts"
      ],
      "customer-account": [
        "./dist/clients/customer-account.d.ts"
      ],
      "admin": [
        "./dist/clients/admin.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "nuxt-shopify": "dist/cli.mjs"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "build:template": "pnpm --filter ./template build --extends ../dev",
    "build:docs": "pnpm --filter ./docs build",
    "dev": "dotenv -e .env -- pnpm --filter playground-v4 dev",
    "dev:mock": "dotenv -e .env -- pnpm --filter playground-v4-mock dev",
    "dev:template": "dotenv -e .env -- pnpm --filter ./template dev --extends ../dev",
    "dev:docs": "dotenv -e .env -- pnpm --filter ./docs dev",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:playgrounds": "dotenv -e .env -- pnpm --filter \"./playgrounds/*\" typecheck",
    "typecheck:playground-v4": "dotenv -e .env -- pnpm --filter playground-v4 typecheck",
    "typecheck:playground-v4-mock": "dotenv -e .env -- pnpm --filter playground-v4-mock typecheck",
    "typecheck:template": "pnpm --filter ./template typecheck --extends ../dev",
    "typecheck:docs": "pnpm --filter ./docs typecheck",
    "knip": "knip",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "test": "pnpm run prepare:playgrounds && dotenv -e .env -- vitest run",
    "test:watch": "dotenv -e .env -- vitest watch",
    "test:coverage": "pnpm run prepare:playgrounds && dotenv -e .env -- vitest run --coverage",
    "analyze": "pnpm --filter playground-v4 analyze",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "prepare": "nuxt-module-build prepare && nuxt-module-build build",
    "prepare:dev": "nuxt-module-build prepare && pnpm run prepare:playgrounds && pnpm --filter ./template prepare --extends ../dev",
    "prepare:playgrounds": "dotenv -e .env -- pnpm --filter \"./playgrounds/*\" prepare",
    "prepare:template": "pnpm run build && pnpm --filter ./template prepare --extends ../dev",
    "prepare:docs": "pnpm --filter ./docs prepare"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/introspection": "^7.0.0",
    "@graphql-codegen/plugin-helpers": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-tools/code-file-loader": "^9.1.2",
    "@graphql-yoga/render-graphiql": "^6.0.1",
    "@nuxt/kit": "^4.6.4",
    "@shopify/graphql-client": "^2.0.1",
    "@shopify/graphql-codegen": "^0.1.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "cookie-es": "^3.1.1",
    "defu": "^6.1.7",
    "exsolve": "^1.2.0",
    "graphql": "^16.15.0",
    "h3": "^1.15.11",
    "lru-cache": "^11.5.3",
    "magic-string": "^1.4.5",
    "minimatch": "^11.0.8",
    "nitropack": "^2.13.6",
    "ohash": "^2.0.12",
    "pathe": "^2.0.3",
    "scule": "^1.3.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@graphql-tools/graphql-tag-pluck": "^9.0.10",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.4",
    "@nuxt/schema": "^4.6.4",
    "@nuxt/test-utils": "^4.4.0",
    "@rollup/plugin-replace": "^6.0.3",
    "@shopify/hydrogen": "^2026.10.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "nuxt": "^4.6.4",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "@shopify/hydrogen": ">=2026.10.3",
    "vue": ">=3.5.0"
  },
  "keywords": [
    "nuxt",
    "nuxt4",
    "nuxtjs",
    "nuxt-module",
    "shopify",
    "ecommerce",
    "storefront",
    "storefront-api",
    "admin-api",
    "graphql",
    "typescript",
    "codegen"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
