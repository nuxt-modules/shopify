{
  "name": "@nuxtjs/shopify",
  "version": "0.9.6",
  "license": "MIT",
  "type": "module",
  "description": "Easily integrate Shopify with Nuxt 3 and 4 🚀",
  "packageManager": "pnpm@11.24.0",
  "workspaces": [
    "playgrounds/*",
    "template",
    "docs",
    "."
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/shopify.git"
  },
  "homepage": "https://shopify.nuxtjs.org",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./storefront": {
      "types": "./dist/clients/storefront.d.ts"
    },
    "./customer-account": {
      "types": "./dist/clients/customer-account.d.ts"
    },
    "./admin": {
      "types": "./dist/clients/admin.d.ts"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/module.d.mts"
      ],
      "storefront": [
        "./dist/clients/storefront.d.ts"
      ],
      "customer-account": [
        "./dist/clients/customer-account.d.ts"
      ],
      "admin": [
        "./dist/clients/admin.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "bin": {
    "nuxt-shopify": "dist/cli.mjs"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "build:template": "pnpm --filter ./template build",
    "build:docs": "pnpm --filter ./docs build",
    "dev": "dotenv -e .env -- pnpm --filter playground-v4 dev",
    "dev:mock": "dotenv -e .env -- pnpm --filter playground-v4-mock dev",
    "dev:v3": "dotenv -e .env -- pnpm --filter playground-v3 dev",
    "dev:template": "dotenv -e .env -- pnpm --filter ./template dev",
    "dev:docs": "dotenv -e .env -- pnpm --filter ./docs dev",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:playgrounds": "pnpm --filter \"./playgrounds/*\" typecheck",
    "typecheck:playground-v4": "pnpm --filter playground-v4 typecheck",
    "typecheck:playground-v4-mock": "pnpm --filter playground-v4-mock typecheck",
    "typecheck:playground-v3": "pnpm --filter playground-v3 typecheck",
    "typecheck:template": "pnpm --filter ./template typecheck",
    "typecheck:docs": "pnpm --filter ./docs typecheck",
    "typecheck:all": "vue-tsc --noEmit && pnpm --filter \"./playgrounds/*\" typecheck && pnpm --filter ./template typecheck && pnpm --filter ./docs typecheck",
    "knip": "knip",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "test": "pnpm run prepare:playgrounds && dotenv -e .env -- vitest run",
    "test:watch": "dotenv -e .env -- vitest watch",
    "test:coverage": "pnpm run prepare:playgrounds && dotenv -e .env -- vitest run --coverage",
    "analyze": "pnpm --filter playground-v4 analyze",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "prepare": "nuxt-module-build prepare",
    "prepare:dev": "nuxt-module-build --filter={./playgrounds/*,./template} prepare",
    "prepare:playgrounds": "dotenv -e .env -- pnpm --filter \"./playgrounds/*\" prepare",
    "prepare:template": "pnpm --filter ./template prepare",
    "prepare:docs": "pnpm --filter ./docs prepare",
    "prepare:all": "nuxt-module-build prepare && dotenv -e .env -- pnpm --filter \"./playgrounds/*\" --filter ./template --filter ./docs prepare",
    "qa:all": "dotenv -e .env -- pnpm run lint && dotenv -e .env -- pnpm run typecheck:all && dotenv -e .env -- pnpm run test"
  },
  "dependencies": {
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/import-types-preset": "^4.0.1",
    "@graphql-codegen/introspection": "^6.1.0",
    "@graphql-codegen/plugin-helpers": "^7.2.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-tools/code-file-loader": "^8.1.37",
    "@graphql-yoga/render-graphiql": "^5.22.0",
    "@nuxt/kit": "^4.5.2",
    "@shopify/api-codegen-preset": "^3.0.0",
    "@shopify/graphql-client": "^2.0.0",
    "@shopify/graphql-codegen": "^0.1.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "giget": "^3.3.1",
    "graphql": "^16.14.2",
    "h3": "^1.15.11",
    "lru-cache": "^11.5.2",
    "magic-string": "^0.30.21",
    "minimatch": "^10.2.6",
    "nitropack": "^2.13.4",
    "ohash": "^2.0.12",
    "scule": "^1.3.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@graphql-tools/graphql-tag-pluck": "^8.3.36",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@shopify/hydrogen": "^2026.4.5",
    "@shopify/hydrogen-react": "^2026.4.3",
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "happy-dom": "^20.11.12",
    "knip": "^6.32.3",
    "nuxt": "^4.5.2",
    "publint": "^0.3.14",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@shopify/hydrogen": ">=2024.0.0",
    "@shopify/hydrogen-react": ">=2024.0.0",
    "vue": "^3.5.41"
  },
  "peerDependenciesMeta": {
    "@shopify/hydrogen": {
      "optional": true
    },
    "@shopify/hydrogen-react": {
      "optional": true
    }
  },
  "keywords": [
    "nuxt",
    "nuxt3",
    "nuxt4",
    "nuxtjs",
    "nuxt-module",
    "shopify",
    "ecommerce",
    "storefront",
    "storefront-api",
    "admin-api",
    "graphql",
    "typescript",
    "codegen"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  }
}
